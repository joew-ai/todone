# Copy to .env.local for local development. Values here are non-secret
# Terraform outputs (see terraform/outputs.tf); never put credentials,
# passwords, setup secrets, or token values in this file or its copies.
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REGISTRATION_CLIENT_ID=
VITE_COGNITO_REGION=us-east-1

# LOCAL DEVELOPMENT ONLY. Set automatically by `npm run setup:local-cognito`,
# which also fills in the two values above with a local-only pool/client.
# Never set this against a deployed pool.
# VITE_COGNITO_LOCAL_ENDPOINT=http://localhost:9229
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=
# COGNITO_LOCAL_ENDPOINT=http://localhost:9229
# TODONE_LOCAL_DEVELOPMENT=true
